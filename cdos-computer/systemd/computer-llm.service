[Unit]
Description=CDOS Computer mini LM (llama.cpp server, local only)
After=network.target

[Service]
User=@USER@
WorkingDirectory=@HERE@
# Small context, all four cores, loopback only.  --jinja lets models that support it call tools.
ExecStart=@HERE@/llama.cpp/build/bin/llama-server -m @MODEL@ -c 1024 -t 4 --host 127.0.0.1 --port 8080 --jinja
Restart=on-failure
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
